# Container publishing (localhost-only by default)
STORM_HOST_BIND=127.0.0.1
STORM_HOST_PORT=8501
STORM_PANGOLIN_IP=172.25.0.106

# Web UI defaults and model catalog behavior
STORM_DEFAULT_LM_PROVIDER=openai_compatible
STORM_DEFAULT_RETRIEVER=duckduckgo
STORM_MODEL_CACHE_TTL_SECONDS=300
STORM_HTTP_TIMEOUT_SECONDS=10

# OpenAI-compatible API (defaults target OpenRouter)
OPENAI_COMPAT_API_BASE=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODELS_URL=https://openrouter.ai/api/v1/models
OPENAI_COMPAT_DEFAULT_MODEL=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=STORM Demo Light

# Anthropic Messages-compatible API
ANTHROPIC_COMPAT_API_BASE=https://api.anthropic.com/v1
ANTHROPIC_COMPAT_API_KEY=
ANTHROPIC_COMPAT_MODELS_URL=https://api.anthropic.com/v1/models
ANTHROPIC_COMPAT_DEFAULT_MODEL=
ANTHROPIC_API_VERSION=2023-06-01

# Web search providers
YDC_API_KEY=
BING_SEARCH_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
SEARXNG_API_URL=
SEARXNG_API_KEY=
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_URL=
AZURE_AI_SEARCH_INDEX_NAME=

# Existing Qdrant collection (online or offline)
QDRANT_MODE=online
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=
QDRANT_VECTOR_STORE_PATH=/data/vector_store
QDRANT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
QDRANT_DEVICE=cpu

# STORM pipeline tuning
STORM_MAX_CONV_TURN=3
STORM_MAX_PERSPECTIVE=3
STORM_SEARCH_TOP_K=3
STORM_RETRIEVE_TOP_K=5
STORM_MAX_THREAD_NUM=10
STORM_REMOVE_DUPLICATE=false
